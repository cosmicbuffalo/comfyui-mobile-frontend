  "RemeshMesh": {
    "input": {
      "required": {
        "mesh": [
          "MESH",
          {}
        ],
        "resolution": [
          "INT",
          {
            "tooltip": "Voxel grid resolution (output density). 256 ~ 100k faces, 512 ~ 1M. For an exact face count, follow with Decimate Mesh.",
            "default": 512,
            "min": 32,
            "max": 2048
          }
        ],
        "sign_mode": [
          "COMFY_DYNAMICCOMBO_V3",
          {
            "display_name": "sign_mode",
            "tooltip": "udf: robust to messy/non-manifold input. sdf: clean single surface with QEF (Quadratic Error Function) sharp-feature recovery, but needs consistent winding. solid: one watertight solid from messy input: a global inside/outside graph cut (CelloCut) removes double shells and closes small holes. Slower.",
            "options": [
              {
                "key": "udf",
                "inputs": {
                  "required": {
                    "qef": [
                      "BOOLEAN",
                      {
                        "tooltip": "QEF (Quadratic Error Function) vertex placement: sharp edges on hard-surface input, jagged creases on organic input.",
                        "advanced": true,
                        "default": false
                      }
                    ],
                    "drop_inverted_components": [
                      "BOOLEAN",
                      {
                        "tooltip": "Drop inward-normal (negative-volume) closed components \u2014 the UDF inner shell.",
                        "advanced": true,
                        "default": false
                      }
                    ],
                    "drop_enclosed_components": [
                      "BOOLEAN",
                      {
                        "tooltip": "Drop components inside the largest's bbox that fail a point-in-mesh raycast. Disable for legitimate nested parts.",
                        "advanced": true,
                        "default": false
                      }
                    ]
                  }
                }
              },
              {
                "key": "sdf",
                "inputs": {
                  "required": {
                    "qef": [
                      "BOOLEAN",
                      {
                        "tooltip": "QEF (Quadratic Error Function) dual-vertex placement (recovers sharp features) vs edge-crossing centroid.",
                        "default": true
                      }
                    ],
                    "manifold": [
                      "BOOLEAN",
                      {
                        "tooltip": "Manifold Dual Contouring: 1-4 dual verts/voxel for multi-sheet cases. Slower.",
                        "default": false
                      }
                    ]
                  }
                }
              },
              {
                "key": "solid",
                "inputs": {
                  "required": {
                    "fill": [
                      "FLOAT",
                      {
                        "tooltip": "Cost of closing an opening relative to following the surface. Lower closes larger openings (0 puts a lid on a cup); higher only closes small holes and cracks.",
                        "default": 20.0,
                        "min": 0.0,
                        "max": 1000.0,
                        "step": 1.0
                      }
                    ],
                    "qef": [
                      "BOOLEAN",
                      {
                        "tooltip": "QEF (Quadratic Error Function) vertex placement: sharp edges on hard-surface input, jagged creases on organic input.",
                        "advanced": true,
                        "default": false
                      }
                    ]
                  }
                }
              }
            ]
          }
        ],
        "band": [
          "FLOAT",
          {
            "tooltip": "Narrow-band width in voxel units. In udf mode also offsets the surface; in solid mode it is the closing radius: creases are filleted and gaps bridged at this size, the surface sits half a voxel out.",
            "advanced": true,
            "default": 1.0,
            "min": 0.5,
            "max": 4.0,
            "step": 0.1
          }
        ],
        "project_back": [
          "FLOAT",
          {
            "tooltip": "Linearly interpolate vertices toward the original surface (0 = pure DC, 1 = snapped).",
            "advanced": true,
            "default": 0.0,
            "min": 0.0,
            "max": 1.0,
            "step": 0.05
          }
        ],
        "fix_poles": [
          "BOOLEAN",
          {
            "tooltip": "Collapse valence-3 vertex pairs (DC T-junction artifact).",
            "advanced": true,
            "default": false
          }
        ],
        "smooth_iters": [
          "INT",
          {
            "tooltip": "Taubin smoothing iterations (0 = off). 2-3 cleans DC staircase-like artifacts; higher over-smooth QEF edges.",
            "default": 0,
            "min": 0,
            "max": 20
          }
        ],
        "drop_small_components": [
          "FLOAT",
          {
            "tooltip": "Drop components below this fraction of the largest's face count. 0 disables.",
            "advanced": true,
            "default": 0.01,
            "min": 0.0,
            "max": 0.5,
            "step": 0.005
          }
        ],
        "precluster_max_verts": [
          "INT",
          {
            "tooltip": "Cap input vertex count before the field queries, inputs above this are cluster-decimated to it first. Prevents OOM on huge meshes.",
            "advanced": true,
            "default": 20000000,
            "min": 0,
            "max": 100000000
          }
        ]
      },
      "hidden": {
        "unique_id": [
          "UNIQUE_ID"
        ]
      }
    },
    "input_order": {
      "required": [
        "mesh",
        "resolution",
        "sign_mode",
        "band",
        "project_back",
        "fix_poles",
        "smooth_iters",
        "drop_small_components",
        "precluster_max_verts"
      ],
      "hidden": [
        "unique_id"
      ]
    },
    "is_input_list": false,
    "output": [
      "MESH"
    ],
    "output_is_list": [
      false
    ],
    "output_name": [
      "mesh"
    ],
    "output_tooltips": [
      null
    ],
    "output_matchtypes": null,
    "name": "RemeshMesh",
    "display_name": "Remesh Mesh (Narrow-Band DC)",
    "description": "Re-extracts a uniformly tessellated mesh via a narrow-band distance field + Dual Contouring, on the active compute device. Normalizes messy / non-manifold / self-intersecting topology; run before Decimate Mesh to hit an exact face count. Output stays welded.",
    "python_module": "comfy_extras.nodes_mesh_postprocess",
    "category": "3d/mesh",
    "output_node": false,
    "deprecated": false,
    "experimental": false,
    "dev_only": false,
    "api_node": false,
    "price_badge": null,
    "search_aliases": null,
    "essentials_category": null,
    "has_intermediate_output": false
  },
